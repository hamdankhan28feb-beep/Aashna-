# ============================================
#  Backend (Node.js)
# ============================================
backend/node_modules/
backend/dist/
backend/build/
backend/coverage/
backend/.nyc_output/
backend/*.tsbuildinfo

# ============================================
#  Frontend (Node.js + Vite)
# ============================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.tsbuildinfo
frontend/.vite/

# ============================================
#  Frontend: Large Model Binaries (YOLO, ASL, etc.)
# ============================================
frontend/public/models/

# ============================================
#  ML / Data Science: Large Artifacts (CRITICAL)
# ============================================
# Ignore ALL raw/processed data (keep .gitkeep only)
ml/data/raw/*
!ml/data/raw/.gitkeep

ml/data/processed/*
!ml/data/processed/.gitkeep

ml/data/landmarks/*
!ml/data/landmarks/.gitkeep

# Ignore all trained models (keep .gitkeep only)
ml/models/*
!ml/models/.gitkeep

# Ignore dev scripts and tests if they are just utility code
ml/scripts/
ml/tests/

# ============================================
#  ML: Global binary / weight catches
# ============================================
*.npy
*.npz
*.h5
*.keras
*.tflite
*.pb
*.onnx
*.pkl
*.joblib
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.qoder

# ============================================
#  Keep small config files (OPTIONAL - uncomment if needed)
# ============================================
# !ml/data/landmarks/classes.txt
# !ml/data/processed/classes.txt
# !ml/data/processed/label_mapping.json
# !ml/verification_results.json